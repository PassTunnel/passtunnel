    "Daemon (passtunneld): installed, but not answering" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan hizmeti (passtunneld): yüklü, ancak yanıt vermiyor"
          }
        }
      }
    },
    "Daemon (passtunneld): running (protocol %lld)" : {
      "localizations" : {
        "tr" : {
