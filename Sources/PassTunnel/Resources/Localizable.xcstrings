{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ +%lld more" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ +%2$lld tane daha"
          }
        }
      }
    },
    "%@ did not connect within %lld seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$lld saniye içinde bağlanmadı."
          }
        }
      }
    },
    "%@ did not disconnect within %lld seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bağlantısı %2$lld saniye içinde kesilmedi."
          }
        }
      }
    },
    "%@ dropped" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantısı koptu"
          }
        }
