          }
        }
      }
    },
    "--follow cannot be combined with --json." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--follow, --json ile birlikte kullanılamaz."
          }
        }
      }
    },
    "--json works with “helper status” only." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--json yalnızca “helper status” ile çalışır."
          }
        }
      }
    },
    "--lines needs a positive number." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--lines için pozitif bir sayı gerekli."
          }
        }
      }
    },
    "--timeout needs a number of seconds (1–86400)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--timeout için saniye cinsinden bir sayı gerekli (1–86400)."
          }
        }
      }
    },
    "0 means no limit. With a limit, PassTunnel reminds you before the server ends the session." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 limit yok demektir. Limit varsa PassTunnel, sunucu oturumu sonlandırmadan önce size hatırlatır."
          }
        }
      }
    },
    "1 minute" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dakika"
          }
        }
      }
    },
    "10.0.0.5 or host:port" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10.0.0.5 ya da sunucu:port"
          }
        }
      }
    },
    "15 minutes" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 dakika"
          }
        }
      }
    },
    "5 minutes" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 dakika"
          }
        }
      }
    },
    "A click shows a hidden code for %lld seconds; copying never shows it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli bir koda tıklamak onu %lld saniye gösterir; kopyalamak hiçbir zaman göstermez."
          }
        }
      }
    },
    "A DNS script. PassTunnel sets DNS from what the server sends." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir DNS betiği. PassTunnel, DNS’i sunucunun gönderdiklerine göre ayarlar."
          }
        }
      }
    },
    "A log file. PassTunnel keeps the connection’s log itself." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir günlük dosyası. Bağlantının günlüğünü PassTunnel kendisi tutar."
          }
        }
      }
    },
    "A screenshot or a photo of the QR." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kodunun ekran görüntüsü ya da fotoğrafı."
          }
        }
      }
    },
    "A variable for scripts. PassTunnel runs none." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betikler için bir değişken. PassTunnel hiçbir betik çalıştırmaz."
          }
        }
      }
    },
    "Active connections stop while the helper is replaced." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı değiştirilirken etkin bağlantılar kesilir."
          }
        }
      }
    },
    "Add a VPN" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir VPN ekleyin"
          }
        }
      }
    },
    "Add one to get started." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamak için bir profil ekleyin."
          }
        }
      }
    },
    "Allows scripts. PassTunnel never runs scripts from a profile." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betiklere izin verir. PassTunnel bir profildeki betikleri hiçbir zaman çalıştırmaz."
          }
        }
      }
    },
    "Another PassTunnel process is changing the secrets file. Try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir PassTunnel işlemi gizli bilgi dosyasını değiştiriyor. Yeniden deneyin."
          }
        }
      }
    },
