            "state" : "translated",
            "value" : "Bu Mac’te Secure Enclave olmadığından bu koruma kullanılamıyor."
          }
        }
      }
    },
    "This helper belongs to another version of PassTunnel. It updates itself when all VPN connections are disconnected." : {
      "localizations" : {
