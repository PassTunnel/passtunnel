          }
        }
      }
    },
    "PassTunnel never runs scripts from a profile. DNS comes from what the server sends instead." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel bir profildeki betikleri hiçbir zaman çalıştırmaz. DNS bunun yerine sunucunun gönderdiklerinden gelir."
          }
        }
      }
    },
    "PassTunnel runs the connection, its log and its management interface itself." : {
      "localizations" : {
