        }
      }
    },
    "Your clock is %lld s ahead of the gateway’s, so one-time codes made from it are likely refused. Fix the clock, then try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatiniz ağ geçidininkinden %lld sn ileride, bu yüzden ona göre üretilen tek kullanımlık kodlar büyük olasılıkla reddedilir. Saati düzeltip yeniden deneyin."
          }
        }
      }
    },
    "Your clock is %lld s ahead of the time server %@, so one-time codes made from it are likely refused. Fix the clock, then try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatiniz %2$@ zaman sunucusundan %1$lld sn ileride, bu yüzden ona göre üretilen tek kullanımlık kodlar büyük olasılıkla reddedilir. Saati düzeltip yeniden deneyin."
          }
        }
      }
    },
    "Your clock is %lld s behind the gateway’s, so one-time codes made from it are likely refused. Fix the clock, then try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatiniz ağ geçidininkinden %lld sn geride, bu yüzden ona göre üretilen tek kullanımlık kodlar büyük olasılıkla reddedilir. Saati düzeltip yeniden deneyin."
          }
        }
      }
    },
    "Your clock is %lld s behind the time server %@, so one-time codes made from it are likely refused. Fix the clock, then try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatiniz %2$@ zaman sunucusundan %1$lld sn geride, bu yüzden ona göre üretilen tek kullanımlık kodlar büyük olasılıkla reddedilir. Saati düzeltip yeniden deneyin."
          }
        }
      }
    },
    "Your clock matches the gateway’s, %lld s apart." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatiniz ağ geçidininkiyle uyuşuyor, aradaki fark %lld sn."
