    "Testing…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test ediliyor…"
          }
        }
      }
    },
    "The code belongs to a VPN profile. Add or import the VPN, then add its code." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod bir VPN profiline aittir. Önce VPN’i ekleyin ya da içe aktarın, sonra kodunu ekleyin."
          }
        }
      }
    },
    "The code is added when you save the profile." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod, profili kaydettiğinizde eklenir."
          }
        }
      }
    },
    "The code is sent as the answer to the server’s challenge prompt (static-challenge), not inside the password." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod parolanın içinde değil, sunucunun sorgusuna (static-challenge) yanıt olarak gönderilir."
          }
        }
      }
    },
    "The code is sent in the gateway’s own one-time code field, after the password." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod, paroladan sonra ağ geçidinin kendi tek kullanımlık kod alanında gönderilir."
          }
        }
      }
    },
    "The code template is not valid: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod şablonu geçerli değil: %@"
          }
        }
      }
    },
    "The configuration could not be imported." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılandırma içe aktarılamadı."
          }
        }
      }
    },
    "The connection attempt was cancelled." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı denemesi iptal edildi."
          }
        }
      }
    },
    "saved in Keychain, encrypted (Touch ID)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar Zinciri’nde, şifreli (Touch ID)"
          }
        }
      }
    },
    "show the code for “%@”" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kodunu göstermek"
          }
        }
      }
    },
    "the confirmation cannot be shown in this session (for example over SSH). Use PassTunnel on the Mac itself." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "doğrulama bu oturumda gösterilemiyor (örneğin SSH üzerinden). PassTunnel’ı Mac’in başında kullanın."
          }
        }
      }
    },
    "the confirmation failed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "doğrulama başarısız oldu."
          }
        }
      }
    },
    "the connection was interrupted" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bağlantı kesildi"
          }
        }
      }
    },
    "the connection was refused (is this a properly signed build?)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bağlantı reddedildi (bu sürüm doğru imzalanmış mı?)"
          }
        }
      }
    },
    "The file contains the profile’s settings and VPN configuration. It does not contain your username, password or one-time code secret." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya profilin ayarlarını ve VPN yapılandırmasını içerir. Kullanıcı adınızı, parolanızı ya da tek kullanımlık kod gizli anahtarınızı içermez."
          }
        }
      }
    },
    "The file “%@” could not be read or is damaged." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dosyası okunamadı ya da bozuk."
          }
        }
      }
    },
    "The file “%@” is too large." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dosyası çok büyük."
          }
        }
      }
    },
    "The gateway %@ presented a certificate with this SHA-256 fingerprint:\n\n%@\n\nTrust it only if it matches the fingerprint your administrator gave you." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ağ geçidi bu SHA-256 parmak izine sahip bir sertifika sundu:\n\n%2$@\n\nYalnızca yöneticinizin verdiği parmak iziyle eşleşiyorsa güvenin."
          }
        }
      }
    },
    "The gateway did not answer in time." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ geçidi zamanında yanıt vermedi."
          }
        }
      }
    },
    "The gateway did not present a certificate." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ geçidi bir sertifika sunmadı."
          }
        }
      }
    },
    "The health check host can be reached again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağlık kontrolü sunucusuna yeniden ulaşılabiliyor."
          }
        }
      }
    },
    "The helper is installed and running." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı yüklü ve çalışıyor."
          }
        }
      }
    },
    "The helper is not installed yet. Finish the installation in PassTunnel → Settings → Helper." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı henüz kurulmadı. Kurulumu PassTunnel → Ayarlar → Yardımcı bölümünde tamamlayın."
          }
        }
      }
    },
    "The helper is not installed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı kurulu değil."
          }
        }
      }
    },
    "The helper is not ready" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı hazır değil"
          }
        }
      }
    },
    "The helper is still installed. Confirm the removal in PassTunnel → Settings → Helper." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı hâlâ kurulu. Kaldırmayı PassTunnel → Ayarlar → Yardımcı bölümünde onaylayın."
          }
        }
      }
    },
    "The helper was removed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardımcı kaldırıldı."
          }
        }
      }
    },
    "The image could not be read." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntü okunamadı."
          }
        }
      }
    },
    "The new configuration replaces the current one when you save." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydettiğinizde yeni yapılandırma mevcut olanın yerini alır."
          }
        }
      }
    },
    "The OpenVPN configuration contains settings PassTunnel does not allow for security reasons:\n%@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenVPN yapılandırması, PassTunnel’ın güvenlik nedeniyle izin vermediği ayarlar içeriyor:\n%@"
          }
        }
      }
    },
    "The OpenVPN configuration refers to “%@”, which is missing or cannot be embedded. Keep the referenced files next to the .ovpn file." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenVPN yapılandırması “%@” dosyasına başvuruyor, ancak bu dosya eksik ya da gömülemiyor. Başvurulan dosyaları .ovpn dosyasının yanında tutun."
          }
        }
      }
    },
    "The OpenVPN management interface did not answer in time." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenVPN yönetim arayüzü zamanında yanıt vermedi."
          }
        }
      }
    },
    "The OpenVPN management interface is in use by another client." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenVPN yönetim arayüzü başka bir istemci tarafından kullanılıyor."
          }
        }
      }
    },
    "The OpenVPN management socket path is too long: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenVPN yönetim soketi yolu çok uzun: %@"
          }
        }
      }
    },
    "The otpauth link is not valid: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "otpauth bağlantısı geçerli değil: %@"
          }
        }
      }
    },
    "The PassTunnel helper could not start the connection: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı bağlantıyı başlatamadı: %@"
          }
        }
      }
    },
    "The PassTunnel helper did not answer within %lld seconds." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The PassTunnel helper did not answer within %lld second."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The PassTunnel helper did not answer within %lld seconds."
                }
              }
            }
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı %lld saniye içinde yanıt vermedi."
          }
        }
      }
    },
    "The PassTunnel helper is missing from the app bundle. Reinstall PassTunnel." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı uygulama paketinde yok. PassTunnel’ı yeniden yükleyin."
          }
        }
      }
    },
    "The PassTunnel helper is not installed. Install it from the app’s setup screen." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı yüklü değil. Uygulamanın kurulum ekranından yükleyin."
          }
        }
      }
    },
    "The PassTunnel helper needs your approval in System Settings → General → Login Items." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı Sistem Ayarları → Genel → Giriş Öğeleri bölümünde onayınızı bekliyor."
          }
        }
      }
    },
    "The PassTunnel helper sent an invalid response." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassTunnel yardımcısı geçersiz bir yanıt gönderdi."
          }
        }
      }
    },
    "The password is now taken from the Keychain." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola artık Anahtar Zinciri’nden alınıyor."
          }
        }
      }
    },
    "the period is not valid" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "süre geçerli değil"
          }
        }
      }
    },
    "The port must be between 1 and 65535." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port 1 ile 65535 arasında olmalı."
          }
        }
      }
    },
    "The profile could not be shared." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil paylaşılamadı."
          }
        }
      }
    },
    "The profile name cannot be empty." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil adı boş olamaz."
          }
        }
      }
    },
    "The profile, its configuration and its Keychain items are removed. This cannot be undone." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil, yapılandırması ve Anahtar Zinciri öğeleri silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "The QR code does not contain an otpauth:// link." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kodu bir otpauth:// bağlantısı içermiyor."
          }
        }
      }
    },
    "the secret is missing" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gizli anahtar eksik"
          }
        }
      }
    },
    "The server rejected the sign-in. Check the user name, password and one-time code." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucu oturum açmayı reddetti. Kullanıcı adını, parolayı ve tek kullanımlık kodu denetleyin."
          }
        }
      }
    },
    "The session limit cannot be negative." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum limiti negatif olamaz."
          }
        }
      }
    },
    "The session limit is reached in %lld minutes." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The session limit is reached in %lld minute."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The session limit is reached in %lld minutes."
                }
              }
            }
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum limitine %lld dakika kaldı."
          }
        }
