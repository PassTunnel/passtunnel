          }
        }
      }
    },
    "A click shows a hidden code for %lld seconds; copying never shows it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli bir koda tıklamak onu %lld saniye gösterir; kopyalamak hiçbir zaman göstermez."
          }
        }
      }
    },
    "A DNS script. PassTunnel sets DNS from what the server sends." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir DNS betiği. PassTunnel, DNS’i sunucunun gönderdiklerine göre ayarlar."
          }
        }
      }
    },
    "A log file. PassTunnel keeps the connection’s log itself." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir günlük dosyası. Bağlantının günlüğünü PassTunnel kendisi tutar."
          }
        }
      }
    },
    "A screenshot or a photo of the QR." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
