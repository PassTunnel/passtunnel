    },
    "%@ dropped." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantısı düştü."
          }
        }
      }
    },
    "%@ is already connected." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zaten bağlı."
          }
        }
      }
    },
    "%@ is connected and sends some of the same traffic as %@ through its tunnel." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bağlı ve %2$@ ile aynı trafiğin bir kısmını kendi tüneli üzerinden gönderiyor."
          }
        }
      }
    },
    "%@ is not a PassTunnel secrets file, or it is damaged." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir PassTunnel gizli bilgi dosyası değil ya da bozuk."
          }
        }
      }
    },
    "%@ is not responding" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıt vermiyor"
          }
        }
      }
    },
    "%@ is responding again" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yeniden yanıt veriyor"
          }
        }
      }
    },
    "%@ is still connected." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hâlâ bağlı."
          }
        }
