    "%@ is already connected." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zaten bağlı."
          }
        }
      }
    },
    "%@ is not a PassTunnel secrets file, or it is damaged." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir PassTunnel gizli bilgi dosyası değil ya da bozuk."
          }
        }
      }
    },
    "%@ is not responding" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıt vermiyor"
          }
        }
      }
    },
    "%@ is responding again" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yeniden yanıt veriyor"
          }
        }
