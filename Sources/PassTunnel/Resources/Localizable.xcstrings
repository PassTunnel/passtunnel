        }
      }
    },
    "VPN tools need administrator rights to create the tunnel. The helper only runs the signed copies of OpenVPN and openfortivpn inside PassTunnel, never anything else." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN araçlarının tüneli kurmak için yönetici yetkisine ihtiyacı var. Yardımcı yalnızca PassTunnel’ın içindeki imzalı OpenVPN ve openfortivpn kopyalarını çalıştırır, başka hiçbir şeyi değil."
          }
        }
      }
    },
    "Waiting for a fresh code · %lld s" : {
