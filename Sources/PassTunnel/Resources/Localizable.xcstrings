          }
        }
      }
    },
    "Show where passwords and TOTP secrets are kept, or choose it: auto, secret-service (the desktop keyring), systemd-creds or file (encrypted with a passphrase)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolaların ve TOTP gizli anahtarlarının nerede tutulduğunu gösterir ya da bunu seçer: auto, secret-service (masaüstü anahtarlığı), systemd-creds ya da file (parola ifadesiyle şifrelenmiş)."
          }
        }
      }
    },
    "systemd-creds did not answer within %lld seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "systemd-creds %lld saniye içinde yanıt vermedi."
          }
        }
      }
    },
    "systemd-creds encrypts credentials for a user from systemd 256 on; this system has systemd %lld." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "systemd-creds bir kullanıcı için kimlik bilgilerini systemd 256’dan itibaren şifreler; bu sistemde systemd %lld var."
          }
