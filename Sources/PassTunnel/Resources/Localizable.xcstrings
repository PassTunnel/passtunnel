{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ +%lld more" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ +%2$lld tane daha"
          }
        }
      }
    },
    "%@ are connected and send some of the same traffic as %@ through their tunnels." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bağlı ve %2$@ ile aynı trafiğin bir kısmını kendi tünelleri üzerinden gönderiyor."
          }
        }
      }
    },
    "%@ did not connect within %lld seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$lld saniye içinde bağlanmadı."
          }
        }
      }
    },
    "%@ did not disconnect within %lld seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bağlantısı %2$lld saniye içinde kesilmedi."
          }
        }
      }
    },
    "%@ didn’t answer" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıt vermedi"
          }
        }
      }
    },
    "%@ dropped" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantısı koptu"
