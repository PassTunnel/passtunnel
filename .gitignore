.build/
.swiftpm/
/build/
/dist/
# passtunnel and passtunneld for the tunnel tests (Tests/ocserv/README.md).
/ocserv-bin/
*.xcodeproj
.DS_Store

# Signing material: never in the repository (docs/RELEASING.md exports keys outside of it). .key and
# .pem only at the top level, so test fixtures elsewhere stay visible.
sparkle-private-key.txt
*.p8
*.p12
*.mobileprovision
*.provisionprofile
/*.key
/*.pem

# Tool cdhash pins, written by scripts/build-app.sh for the build it makes (see PinnedTools.swift).
/Sources/PassTunnelShared/PinnedTools+Generated.swift
# Version and build number of a Linux release build, written by scripts/build-linux.sh (see
# BuildVersion.swift and DaemonBuild.swift).
/Sources/PassTunnelCore/BuildVersion+Generated.swift
/Sources/PassTunnelDaemon/DaemonBuild+Generated.swift
