# Where PassTunnel is published: the single source of truth for the GitHub slugs.
# Sourced by build-app.sh (stamps Info.plist: SUFeedURL, PTGitHubRepository) and release.sh (download
# URLs, appcast, Homebrew cask, gh release). ProjectLinksTests checks that the sources and docs agree.
GITHUB_REPO=passtunnel/passtunnel
TAP_REPO=passtunnel/homebrew-tap
