# Where PassTunnel is published: the single source of truth for the GitHub slugs.
# Sourced by build-app.sh (stamps Info.plist: SUFeedURL, PTGitHubRepository), bundle-tools.sh (tool
# versions), release.sh (download URLs, appcast, Homebrew cask, gh release) and make-server-json.sh
# (MCP bundle URL). ProjectLinksTests checks that the sources and docs agree.
GITHUB_REPO=passtunnel/passtunnel
TAP_REPO=passtunnel/homebrew-tap

# Homebrew versions of the tools bundled into the app (the Cellar directory name, with a Homebrew
# revision like _1 when there is one). bundle-tools.sh prints what it bundles and stops when a
# formula is missing here or has another version. To move to new versions: `brew upgrade`, check the
# upstream changelogs, then update these lines in the same commit. PASSTUNNEL_ALLOW_UNPINNED_TOOLS=1
# turns the stop into a warning for local builds; release.sh refuses it.
OPENVPN_VERSION=2.7.8_1
OPENFORTIVPN_VERSION=1.24.1_1
OPENSSL4_VERSION=4.1.0
LZ4_VERSION=1.10.0
LZO_VERSION=2.10
PKCS11_HELPER_VERSION=1.31.0_1
OPENCONNECT_VERSION=9.21
GNUTLS_VERSION=3.8.13_2
NETTLE_VERSION=4.0
GMP_VERSION=6.3.0
P11_KIT_VERSION=0.26.5
LIBTASN1_VERSION=4.21.0
LIBIDN2_VERSION=2.3.8
LIBUNISTRING_VERSION=1.5
GETTEXT_VERSION=1.0
STOKEN_VERSION=0.93_2
LIBTOMCRYPT_VERSION=1.18.2_1
LIBTOMMATH_VERSION=1.3.0
