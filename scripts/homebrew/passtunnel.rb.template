# Generated by scripts/release.sh from scripts/homebrew/passtunnel.rb.template.
cask "passtunnel" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@GITHUB_REPO@/releases/download/v#{version}/PassTunnel-#{version}.dmg"
  name "PassTunnel"
  desc "OpenVPN and FortiGate client that fills in one-time codes"
  homepage "https://github.com/@GITHUB_REPO@"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :ventura

  app "PassTunnel.app"
  binary "#{appdir}/PassTunnel.app/Contents/MacOS/PassTunnel", target: "passtunnel"

  # The helper is a launchd daemon registered from inside the app bundle (SMAppService); there is
  # nothing in /Library/PrivilegedHelperTools. Removing the job stops its VPN sessions.
  uninstall launchctl: "com.furkanprlk.passtunnel.helper",
            quit:      "com.furkanprlk.passtunnel"

  # Passwords and TOTP secrets: generic-password items of the service "PassTunnel" in the login
  # Keychain. Removed one per call, as the user (no sudo); bounded in case the Keychain misbehaves.
  zap script: {
        executable: "/bin/sh",
        args:       [
          "-c",
          "i=0; while [ $i -lt 1000 ] && /usr/bin/security delete-generic-password -s PassTunnel " \
          ">/dev/null 2>&1; do i=$((i + 1)); done",
        ],
      },
      trash:  [
        "/usr/local/bin/passtunnel",
        "~/.local/bin/passtunnel",
        "~/Library/Application Support/PassTunnel",
        "~/Library/Caches/com.furkanprlk.passtunnel",
        "~/Library/HTTPStorages/com.furkanprlk.passtunnel",
        "~/Library/Preferences/com.furkanprlk.passtunnel.plist",
        "~/Library/Saved Application State/com.furkanprlk.passtunnel.savedState",
      ]

  caveats <<~EOS
    The helper's entry in System Settings → General → Login Items disappears the next time macOS
    cleans up its background items, at the latest after a restart.

    Passwords and TOTP secrets stay in your login Keychain (service "PassTunnel") after a plain
    uninstall; `brew uninstall --zap passtunnel` removes them. To remove them by hand, use Keychain
    Access or:
      while security delete-generic-password -s PassTunnel >/dev/null 2>&1; do :; done
  EOS
end
