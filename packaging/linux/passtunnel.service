# passtunneld, PassTunnel's root daemon on Linux (docs/LINUX.md): it runs the distribution's openvpn
# for the users allowed to connect. A first version: no package or tarball installs it yet, and the
# sandbox below is a starting point, to be trimmed to what the tools need once they are tested under
# it on the target distributions.

[Unit]
Description=PassTunnel daemon
Documentation=https://github.com/PassTunnel/passtunnel/blob/main/docs/LINUX.md
Requires=passtunnel.socket
After=passtunnel.socket

[Service]
Type=simple
ExecStart=/usr/sbin/passtunneld
# Stopping the daemon stops every tunnel: it sends SIGTERM to its tools itself, and the default
# KillMode=control-group then stops whatever is left in the unit's cgroup. Nothing outlives the unit;
# a daemon that starts again finds no tool to adopt.
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

# The tools configure interfaces, routes and sockets (NET_ADMIN, NET_RAW) and may change user
# (SETUID, SETGID); the daemon hands the log and the management socket to the user (CHOWN), works in
# the user's profile directory (DAC_OVERRIDE) and stops the tools (KILL). It sets the management
# socket's mode while root still owns it, so CAP_FOWNER is not needed. The DNS hook, which OpenVPN
# runs inside this unit, is let through by systemd-resolved for NET_ADMIN.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
# The tun device for OpenVPN, /dev/ppp for openfortivpn's pppd (FortiGate, still to come); besides
# these only the standard pseudo devices (/dev/null, /dev/urandom, /dev/ptmx, …).
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/ppp rw
# The file system read-only but for the run root and what the DNS hook writes: /etc, where it
# replaces /etc/resolv.conf by renaming a file written next to it (which needs the directory, and
# openresolv writes the file itself), and resolvconf's records in /run/resolvconf (when it is
# installed). Where systemd-resolved manages DNS neither is written: it is told over D-Bus.
ProtectSystem=strict
ReadWritePaths=/run/passtunnel /etc -/run/resolvconf
PrivateTmp=yes

# Not set, on purpose:
# - ProtectHome=read-only: the daemon creates the session log (vpn.log) in the user's profile
#   directory, ~/.local/share/passtunnel/profiles/<id>/, which it would forbid. It becomes possible
#   once the log is opened by the client or kept outside the home directory.
# - RuntimeDirectory=passtunnel: systemd removes that directory when the service stops, and with it
#   the socket that passtunnel.socket keeps listening on. The socket unit creates /run/passtunnel.
# - NoNewPrivileges=yes: it only stops gaining privileges through exec (set-user-ID files, file
#   capabilities), which adds nothing here: the daemon and its tools already run as root, within the
#   bounding set above. Dropping privileges (OpenVPN's --user, which the sanitizer refuses anyway) is
#   not affected by it. It would however stop SELinux domain transitions on exec (openvpn_t, pppd_t
#   on Fedora and RHEL) unless the policy allows nnp_transition, so it waits for testing there.

[Install]
Also=passtunnel.socket
