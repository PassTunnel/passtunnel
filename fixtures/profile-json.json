{
  "about": "profile.json as a save writes it back after reading it (and changing the type or setting fields, as `passtunnel set` does): the keys a newer version added are kept as read, unless the type changed; keys of another type and keys inside `totp` are not kept.",
  "save": [
    {
      "name": "a key a newer version added survives a save",
      "stored": {
        "id": "acme",
        "name": "Acme",
        "type": "openvpn",
        "future_option": "on"
      },
      "saved": {
        "auto_reconnect": false,
        "badge": "",
