        "future_option": "on",
        "health_host": "",
        "host": "",
        "icon": "",
        "id": "acme",
        "last_username": "",
        "mgmt_port": 0,
        "name": "Acme",
        "order": 0,
        "otp_delivery": "combined",
        "otp_mode": "none",
        "otp_template": "{password}{otp}",
        "password_mode": "keychain",
        "pinned": false,
        "port": 443,
        "require_auth": "off",
        "session_limit_min": 0,
        "set_dns": false,
        "set_routes": true,
        "totp": {
          "algorithm": "sha1",
