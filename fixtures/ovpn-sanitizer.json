  "sanitize": [
    {
      "name": "a typical client config passes unchanged",
      "config": "# Acme VPN\nclient\ndev tun\nproto udp\nremote vpn.example.com 1194\nresolv-retry infinite\nnobind\npersist-key\npersist-tun\nremote-cert-tls server\nauth-user-pass\nscript-security 1\nsetenv FORWARD_COMPATIBLE 1\nsetenv opt block-outside-dns\nverb 3\n<ca>\n-----BEGIN CERTIFICATE-----\nMIIBszCCAVmgAwIBAgIUJ\nup /tmp/not-a-directive-inside-a-block\n-----END CERTIFICATE-----\n</ca>\nkey-direction 1\n<tls-auth>\n-----BEGIN OpenVPN Static key V1-----\n0123456789abcdef\n-----END OpenVPN Static key V1-----\n</tls-auth>\n",
      "output": "# Acme VPN\nclient\ndev tun\nproto udp\nremote vpn.example.com 1194\nresolv-retry infinite\nnobind\npersist-key\npersist-tun\nremote-cert-tls server\nauth-user-pass\nscript-security 1\nsetenv FORWARD_COMPATIBLE 1\nsetenv opt block-outside-dns\nverb 3\n<ca>\n-----BEGIN CERTIFICATE-----\nMIIBszCCAVmgAwIBAgIUJ\nup /tmp/not-a-directive-inside-a-block\n-----END CERTIFICATE-----\n</ca>\nkey-direction 1\n<tls-auth>\n-----BEGIN OpenVPN Static key V1-----\n0123456789abcdef\n-----END OpenVPN Static key V1-----\n</tls-auth>\n"
    },
    {
      "name": "CR LF line endings pass unchanged",
      "config": "# Acme VPN\r\nclient\r\ndev tun\r\nproto udp\r\nremote vpn.example.com 1194\r\nresolv-retry infinite\r\nnobind\r\npersist-key\r\npersist-tun\r\nremote-cert-tls server\r\nauth-user-pass\r\nscript-security 1\r\nsetenv FORWARD_COMPATIBLE 1\r\nsetenv opt block-outside-dns\r\nverb 3\r\n<ca>\r\n-----BEGIN CERTIFICATE-----\r\nMIIBszCCAVmgAwIBAgIUJ\r\nup /tmp/not-a-directive-inside-a-block\r\n-----END CERTIFICATE-----\r\n</ca>\r\nkey-direction 1\r\n<tls-auth>\r\n-----BEGIN OpenVPN Static key V1-----\r\n0123456789abcdef\r\n-----END OpenVPN Static key V1-----\r\n</tls-auth>\r\n",
      "output": "# Acme VPN\r\nclient\r\ndev tun\r\nproto udp\r\nremote vpn.example.com 1194\r\nresolv-retry infinite\r\nnobind\r\npersist-key\r\npersist-tun\r\nremote-cert-tls server\r\nauth-user-pass\r\nscript-security 1\r\nsetenv FORWARD_COMPATIBLE 1\r\nsetenv opt block-outside-dns\r\nverb 3\r\n<ca>\r\n-----BEGIN CERTIFICATE-----\r\nMIIBszCCAVmgAwIBAgIUJ\r\nup /tmp/not-a-directive-inside-a-block\r\n-----END CERTIFICATE-----\r\n</ca>\r\nkey-direction 1\r\n<tls-auth>\r\n-----BEGIN OpenVPN Static key V1-----\r\n0123456789abcdef\r\n-----END OpenVPN Static key V1-----\r\n</tls-auth>\r\n"
    },
    {
      "name": "comments, BOM and blank lines pass byte for byte",
      "config": "\ufeff# up /tmp/x\n;plugin x\n   #down\nremote vpn.example.com 1194 # up /tmp/x\n\n\r\n \t \n",
      "output": "\ufeff# up /tmp/x\n;plugin x\n   #down\nremote vpn.example.com 1194 # up /tmp/x\n\n\r\n \t \n"
    },
